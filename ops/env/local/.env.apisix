COMPOSE_PROJECT_NAME=zqzl-local

PROJECT_NAME=zqzl
IMAGE_TAG=latest

NETWORK_NAME=zqzl-local-network

APISIX_IMAGE=zqzl/apisix-gateway:latest

APISIX_HTTP_PORT=8080
APISIX_HTTPS_PORT=8443
APISIX_ADMIN_PORT=9090

API_HOST=api.local.bw.com
SSO_WEB_HOST=sso.local.bw.com
ADMIN_WEB_HOST=admin.local.bw.com

SSO_SERVER_UPSTREAM=host.docker.internal:8081
USER_SERVER_UPSTREAM=host.docker.internal:8082
SSO_WEB_UPSTREAM=host.docker.internal:3001
USER_WEB_UPSTREAM=host.docker.internal:3002
