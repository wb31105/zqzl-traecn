COMPOSE_PROJECT_NAME=zqzl-integration

PROJECT_NAME=zqzl
IMAGE_TAG=latest

NETWORK_NAME=zqzl-network

APISIX_IMAGE=zqzl/apisix-gateway:latest
SSO_SERVER_IMAGE=zqzl/sso-server:latest
USER_SERVER_IMAGE=zqzl/user-server:latest
SSO_WEB_IMAGE=zqzl/sso-web:latest
USER_WEB_IMAGE=zqzl/user-web:latest

APISIX_HTTP_PORT=80
APISIX_HTTPS_PORT=443
APISIX_ADMIN_PORT=9090

API_HOST=api.bw.com
SSO_WEB_HOST=sso.bw.com
ADMIN_WEB_HOST=admin.bw.com

SSO_SERVER_UPSTREAM=sso-server:8080
USER_SERVER_UPSTREAM=user-server:8080
SSO_WEB_UPSTREAM=sso-web:80
USER_WEB_UPSTREAM=user-web:80

SSO_SERVER_PORT=8080
SSO_SERVER_GRPC_PORT=9090
SSO_SERVER_PROFILE=prod
USER_GRPC_HOST=user-server
USER_GRPC_PORT=9090
SSO_ISSUER_URI=http://${API_HOST}
SSO_JWK_SET_URI=http://sso-server:8080/oauth2/jwks
SSO_WEB_LOGIN_URL=http://${SSO_WEB_HOST}/login
SSO_WEB_LOGOUT_URL=http://${SSO_WEB_HOST}/login?logout
SSO_CLIENT_USER_WEB_REDIRECT_URI=http://${ADMIN_WEB_HOST}/sso/callback

USER_SERVER_PORT=8080
USER_SERVER_GRPC_PORT=9090
USER_SERVER_PROFILE=prod
SSO_GRPC_HOST=sso-server
SSO_GRPC_PORT=9090
USER_SSO_ISSUER_URI=http://${API_HOST}
USER_SSO_JWK_SET_URI=http://sso-server:8080/oauth2/jwks
SSO_TOKEN_URI=http://${API_HOST}/oauth2/token
SSO_AUTHORIZATION_URI=http://${API_HOST}/oauth2/authorize
SSO_REDIRECT_URI=http://${ADMIN_WEB_HOST}/sso/callback
SSO_OAUTH2_SCOPE=openid profile read write
USER_JWT_SECRET=my-super-secret-key-for-jwt-token-generation-at-least-256-bits-long
USER_JWT_EXPIRATION=86400000

SSO_WEB_PORT=80
USER_WEB_PORT=80

REACT_APP_SSO_SERVER_URL=http://${API_HOST}
REACT_APP_API_SERVER_URL=http://${API_HOST}
REACT_APP_USER_WEB_URL=http://${ADMIN_WEB_HOST}
REACT_APP_OAUTH2_AUTH_URI=http://${API_HOST}/oauth2/authorize
REACT_APP_OAUTH2_CLIENT_ID=user-web-client
REACT_APP_OAUTH2_REDIRECT_URI=http://${ADMIN_WEB_HOST}/sso/callback
REACT_APP_OAUTH2_SCOPE=openid profile read write
